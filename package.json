{
  "name": "know-flow",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "check-types": "turbo run check-types",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\""
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/multer": "^2.1.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.3.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "turbo": "^2.8.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1047.0",
    "@aws-sdk/s3-presigned-post": "^3.1047.0",
    "@aws-sdk/s3-request-presigner": "^3.1047.0",
    "bullmq": "^5.71.1",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.2",
    "file-type": "^22.0.1",
    "ioredis": "^5.10.1",
    "multer": "^2.1.1",
    "openai": "^6.33.0",
    "p-limit": "^7.3.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.20.0",
    "zod": "^4.4.3"
  }
}
