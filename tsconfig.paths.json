{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@repo/db": ["packages/db/index.ts"],
      "@repo/db/schema": ["packages/db/schema/index.ts"],
      "@repo/db/repositories/*": ["packages/db/repositories/*"],
      "@repo/db/repositories": ["packages/db/repositories/index.ts"],

      "@repo/queue": ["packages/queue"],
      "@repo/queue/document.queue": ["packages/queue/document.queue"],
      "@repo/queue/email.queue": ["packages/queue/email.queue"],
      "@repo/queue/*": ["packages/queue/*"],

      "@repo/ai": ["packages/ai"],
      "@repo/ai/summarize": ["packages/ai/summarize"],
      "@repo/ai/chunk": ["packages/ai/chunk"],
      "@repo/ai/summarizeChunk": ["packages/ai/summarizeChunk"],
      "@repo/ai/combineSummaries": ["packages/ai/combineSummaries"],

      "@repo/upload/multer": ["packages/upload/multer"],

      "@repo/redis/client": ["packages/redis/client"],
      "@repo/redis/pubsub": ["packages/redis/pubsub"],

      "@repo/storage/upload": ["packages/storage/upload"],
      "@repo/storage/fetchFile": ["packages/storage/fetchFile"],

      "@repo/parser/parse": ["packages/parser/parse"],

      "@repo/events": ["packages/events/index.ts"],
      "@repo/events/*": ["packages/events/*"],

      "@repo/env": ["packages/env/index.ts"],

      "@repo/config/*": ["packages/config/*"],
      "@repo/config": ["packages/config/index.ts"]
    }
  }
}
